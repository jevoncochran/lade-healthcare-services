# Copy to .env.local for local development.

# Where this site's /api/* forwards to: the Lade booking API (lade-hcs-server).
# Read when the site starts (not baked into the build). Locally the API runs
# on port 4000; on Cloud Run, the API service's address.
API_URL=http://localhost:4000

# No Stripe setting here: the API sends its publishable key with each card
# setup (STRIPE_PUBLISHABLE_KEY in lade-hcs-server/.env).
