# Copy to .env.local for local development.

# The Lade booking API (lade-hcs-server). The browser calls it directly with
# cookies, so it must be on the same site as this website in production
# (e.g. https://api.ladehealthcare.com).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stripe publishable key (pk_test_… for development). Safe to expose: it's
# meant for the browser. The secret key only ever goes on the API server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
